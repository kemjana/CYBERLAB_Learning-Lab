# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local to GitHub.

# Required for AI features (get one free at https://aistudio.google.com)
GEMINI_API_KEY=

# Optional: change the Gemini model without touching code
GEMINI_MODEL=gemini-3.8-flash

# Optional: any long random text. Used to hide the phishing answer keys.
TOKEN_SECRET=

# Optional: Supabase (shared leaderboard). Leave blank to use demo mode.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional: override the CTF flags (defaults are in lib/ctf.ts)
CTF_FLAG_1=
CTF_FLAG_2=
CTF_FLAG_3=
